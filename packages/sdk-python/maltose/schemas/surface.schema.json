{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128,
      "minLength": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "props": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 16384
        },
        "title": {
          "type": "string",
          "maxLength": 16384
        },
        "label": {
          "type": "string",
          "maxLength": 16384
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            },
            "maxItems": 32
          },
          "maxItems": 1000
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 10000
        },
        "data_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "sensitive": {
          "type": "boolean"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "type": {
          "enum": [
            "stack",
            "text",
            "button",
            "table",
            "chart.line",
            "canvas",
            "canvas.rect",
            "canvas.ellipse",
            "canvas.triangle",
            "canvas.text"
          ]
        },
        "props": {
          "$ref": "#/$defs/props"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 256
        }
      },
      "required": [
        "node_id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/$defs/node"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "maxLength": 128,
            "minLength": 1
          },
          "maxItems": 128
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 240,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 180,
          "maximum": 10000
        },
        "screen_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set_props"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "props": {
              "$ref": "#/$defs/props"
            }
          },
          "required": [
            "op",
            "node_id",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "insert_node"
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "node": {
              "$ref": "#/$defs/node"
            }
          },
          "required": [
            "op",
            "parent_id",
            "index",
            "node"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_node"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "required": [
            "op",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "move_node"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "op",
            "node_id",
            "parent_id",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "context_event_kind": {
      "enum": [
        "context.focus_changed",
        "context.selection_changed",
        "context.viewport_changed",
        "context.surface_visibility_changed",
        "context.surface_moved",
        "context.surface_detached",
        "context.surface_attached",
        "context.user_override_changed",
        "context.stale",
        "context.permission_changed"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "chart.time_range",
            "node"
          ]
        },
        "value": {
          "type": "object",
          "properties": {
            "start": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "x_domain": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "node_id",
        "x_domain"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://maltose.local/mup/0.3/surface.schema.json",
  "type": "object",
  "properties": {
    "surface_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128,
      "minLength": 1
    },
    "owner_agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128,
      "minLength": 1
    },
    "kind": {
      "enum": [
        "workspace",
        "window",
        "overlay"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "visibility": {
      "type": "boolean"
    },
    "lifecycle": {
      "enum": [
        "active",
        "closed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_overrides": {
      "type": "object",
      "properties": {
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "window_placement": {
          "$ref": "#/$defs/placement"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "surface_id",
    "owner_agent_id",
    "kind",
    "revision",
    "title",
    "document",
    "placement",
    "visibility",
    "lifecycle",
    "created_at",
    "updated_at",
    "user_overrides"
  ],
  "additionalProperties": false
}
