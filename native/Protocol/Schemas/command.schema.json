{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128,
      "minLength": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "props": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 16384
        },
        "title": {
          "type": "string",
          "maxLength": 16384
        },
        "label": {
          "type": "string",
          "maxLength": 16384
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            },
            "maxItems": 32
          },
          "maxItems": 1000
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 10000
        },
        "data_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "sensitive": {
          "type": "boolean"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "type": {
          "enum": [
            "stack",
            "text",
            "button",
            "table",
            "chart.line",
            "canvas",
            "canvas.rect",
            "canvas.ellipse",
            "canvas.triangle",
            "canvas.text"
          ]
        },
        "props": {
          "$ref": "#/$defs/props"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 256
        }
      },
      "required": [
        "node_id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/$defs/node"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "maxLength": 128,
            "minLength": 1
          },
          "maxItems": 128
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 240,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 180,
          "maximum": 10000
        },
        "screen_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set_props"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "props": {
              "$ref": "#/$defs/props"
            }
          },
          "required": [
            "op",
            "node_id",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "insert_node"
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "node": {
              "$ref": "#/$defs/node"
            }
          },
          "required": [
            "op",
            "parent_id",
            "index",
            "node"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_node"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "required": [
            "op",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "move_node"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "maxLength": 128,
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "op",
            "node_id",
            "parent_id",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "context_event_kind": {
      "enum": [
        "context.focus_changed",
        "context.selection_changed",
        "context.viewport_changed",
        "context.surface_visibility_changed",
        "context.surface_moved",
        "context.surface_detached",
        "context.surface_attached",
        "context.user_override_changed",
        "context.stale",
        "context.permission_changed"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "chart.time_range",
            "node"
          ]
        },
        "value": {
          "type": "object",
          "properties": {
            "start": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 4096
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128,
          "minLength": 1
        },
        "x_domain": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "node_id",
        "x_domain"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://maltose.local/mup/0.3/command.schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "mup/0.3"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "command"
    },
    "name": {
      "enum": [
        "host.discover",
        "host.pair.request",
        "host.pair.poll",
        "host.toolkit.get",
        "agent.runtime.publish",
        "agent.input.poll",
        "host.authenticate",
        "host.capabilities",
        "surface.create",
        "surface.list",
        "surface.get",
        "surface.set_visibility",
        "surface.close",
        "surface.detach",
        "surface.attach",
        "ui.render",
        "ui.patch",
        "ui.inspect",
        "events.subscribe",
        "events.unsubscribe",
        "data.register",
        "data.publish",
        "data.unregister",
        "ui.context.get",
        "ui.context.subscribe",
        "ui.context.unsubscribe",
        "ui.context.resolve_reference"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "message_id",
    "session_id",
    "request_id",
    "type",
    "name",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.discover"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.pair.request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "agent_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "maxLength": 128,
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 32,
                "maxLength": 256
              }
            },
            "required": [
              "name",
              "agent_id",
              "claim"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.pair.poll"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "pairing_id": {
                "type": "string",
                "format": "uuid"
              },
              "claim": {
                "type": "string",
                "minLength": 32,
                "maxLength": 256
              }
            },
            "required": [
              "pairing_id",
              "claim"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.toolkit.get"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "agent.runtime.publish"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "format": "uuid"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "event": {
                "enum": [
                  "heartbeat",
                  "state_changed",
                  "model_started",
                  "model_finished",
                  "model_failed",
                  "tool_started",
                  "tool_finished",
                  "tool_failed",
                  "speech_started",
                  "speech_finished",
                  "assistant_start",
                  "assistant_delta",
                  "assistant_end",
                  "user_message",
                  "task_progress",
                  "error"
                ]
              },
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "initializing",
                      "standby",
                      "listening",
                      "thinking",
                      "speaking",
                      "shutdown",
                      "error"
                    ]
                  },
                  "message_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                    "maxLength": 128,
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 16384
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "detail": {
                    "type": "string",
                    "maxLength": 16384
                  },
                  "progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "run_id",
              "sequence",
              "event",
              "data"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "event": {
                    "const": "heartbeat"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "state_changed"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "enum": [
                          "initializing",
                          "standby",
                          "listening",
                          "thinking",
                          "speaking",
                          "shutdown",
                          "error"
                        ]
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "model_started"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "model_finished"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "model_failed"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "tool_started"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "tool"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "tool_finished"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "tool"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "tool_failed"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "tool"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "speech_started"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "speech_finished"
                  },
                  "data": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "assistant_start"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "message_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                        "maxLength": 128,
                        "minLength": 1
                      }
                    },
                    "required": [
                      "message_id"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "assistant_delta"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "message_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                        "maxLength": 128,
                        "minLength": 1
                      },
                      "content": {
                        "type": "string",
                        "maxLength": 16384
                      }
                    },
                    "required": [
                      "message_id",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "assistant_end"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "message_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                        "maxLength": 128,
                        "minLength": 1
                      },
                      "content": {
                        "type": "string",
                        "maxLength": 16384
                      }
                    },
                    "required": [
                      "message_id"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "user_message"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "content": {
                        "type": "string",
                        "maxLength": 16384
                      }
                    },
                    "required": [
                      "content"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "task_progress"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "detail": {
                        "type": "string",
                        "maxLength": 16384
                      },
                      "progress": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                }
              },
              {
                "properties": {
                  "event": {
                    "const": "error"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "detail": {
                        "type": "string",
                        "maxLength": 16384
                      }
                    },
                    "required": [
                      "detail"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "agent.input.poll"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.authenticate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "minLength": 32,
                "maxLength": 256
              }
            },
            "required": [
              "token"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "host.capabilities"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "surface.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "surface_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                "maxLength": 128,
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "workspace",
                  "window",
                  "overlay"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "document": {
                "$ref": "#/$defs/document"
