#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

if [[ ${MALTOSE_BRAIN+x} == x ]]; then export MYAGENT_BRAIN="$MALTOSE_BRAIN"; fi
if [[ ${MALTOSE_WEB_URL+x} == x ]]; then export MYAGENT_WEB_URL="$MALTOSE_WEB_URL"; fi
if [[ ${MALTOSE_WEB_STARTUP_TIMEOUT+x} == x ]]; then export MYAGENT_WEB_STARTUP_TIMEOUT="$MALTOSE_WEB_STARTUP_TIMEOUT"; fi
if [[ ${MALTOSE_OPEN_BROWSER+x} == x ]]; then export MYAGENT_OPEN_BROWSER="$MALTOSE_OPEN_BROWSER"; fi
if [[ ${MALTOSE_BROWSER_APP+x} == x ]]; then export MYAGENT_BROWSER_APP="$MALTOSE_BROWSER_APP"; fi
EXTRAS=(--extra wake --extra qwen-asr --extra vector-memory --extra speaker)
DEFAULT_BRAIN="${MYAGENT_BRAIN:-taskbrain}"
WATCHER_PID=""
AGENT_PID=""
KNOWLEDGE_LOG_DIR="data/logs"
KNOWLEDGE_LOG_FILE="$KNOWLEDGE_LOG_DIR/knowledge.log"
WEB_URL="${MYAGENT_WEB_URL:-http://127.0.0.1:8765/}"
WEB_STARTUP_TIMEOUT="${MYAGENT_WEB_STARTUP_TIMEOUT:-30}"

mkdir -p "$KNOWLEDGE_LOG_DIR"

cleanup() {
  status=$?
  trap - EXIT
  if [[ -n "$WATCHER_PID" ]]; then
    kill "$WATCHER_PID" 2>/dev/null || true
    wait "$WATCHER_PID" 2>/dev/null || true
  fi
  if [[ -n "$AGENT_PID" ]] && kill -0 "$AGENT_PID" 2>/dev/null; then
    kill "$AGENT_PID" 2>/dev/null || true
    wait "$AGENT_PID" 2>/dev/null || true
  fi
  exit "$status"
}

trap cleanup EXIT

uv run "${EXTRAS[@]}" maltose-documents watch >"$KNOWLEDGE_LOG_FILE" 2>&1 &
WATCHER_PID=$!

# Start the local UI by default; additional arguments still pass through to
# maltose, so callers can override the normal runtime configuration.
uv run "${EXTRAS[@]}" maltose --web --brain "$DEFAULT_BRAIN" "$@" &
AGENT_PID=$!

wait_for_web_ui() {
  local deadline=$((SECONDS + WEB_STARTUP_TIMEOUT))
  while (( SECONDS < deadline )); do
    if ! kill -0 "$AGENT_PID" 2>/dev/null; then
      return 2
    fi
    if curl --silent --fail --max-time 1 "$WEB_URL" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

open_web_ui() {
  if [[ "${MYAGENT_OPEN_BROWSER:-1}" == "0" ]]; then
    return 0
  fi
  if wait_for_web_ui; then
    :
  else
    local startup_status=$?
    if [[ "$startup_status" == "2" ]]; then
      printf 'Maltose 已在 UI 就緒前結束，請查看上方啟動錯誤。\n' >&2
    else
      printf 'Maltose UI did not become ready at %s\n' "$WEB_URL" >&2
    fi
    return 0
  fi

  case "${OSTYPE:-}" in
    darwin*)
      if [[ -n "${MYAGENT_BROWSER_APP:-}" ]]; then
        open -a "$MYAGENT_BROWSER_APP" "$WEB_URL"
      else
        open "$WEB_URL"
      fi
      ;;
    linux*)
      if [[ -n "${MYAGENT_BROWSER_APP:-}" ]]; then
        "$MYAGENT_BROWSER_APP" "$WEB_URL"
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$WEB_URL" >/dev/null 2>&1 &
      fi
      ;;
    msys*|cygwin*|win32*)
      start "" "$WEB_URL"
      ;;
    *)
      printf 'Maltose UI is ready at %s\n' "$WEB_URL"
      ;;
  esac
}

open_web_ui
wait "$AGENT_PID"
